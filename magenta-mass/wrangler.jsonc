{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "refuweegee-dev",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": { "enabled": true },

  "vars": {
    "WIX_CLIENT_ID": "d0686898-a815-4d4c-bcd9-ebac2d0e6caf"
  },
  "kv_namespaces": [
    { "binding": "SESSION", "id": "895e4b0d1b334050b8272e313b0e8f3c" }
  ],
  "routes": [
    {
      "pattern": "refuweegee.static-orbit.co.uk",
      "zone_name": "static-orbit.co.uk",
      "custom_domain": true
    }
  ]
}