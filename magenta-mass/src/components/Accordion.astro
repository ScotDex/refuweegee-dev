---
import Accordion from "./Accordion.astro";

interface AccordionItem {
  title: string;
  content?: string;
  items?: AccordionItem[];
  withBackground?: boolean;
}

interface Props {
  items: AccordionItem[];
  id?: string;
}

const { items, id = "accordion" } = Astro.props;
---

<div class="divide-y divide-slate-200">
  {
    items.map((item, index) => {
      const titleId = `${id}-title-${index}`;
      const panelId = `${id}-text-${index}`;
      const HeadingTag = item.withBackground ? "h2" : "h3";
      return (
        <div
          class="accordion-item py-2"
          class:list={
            item.withBackground
              ? "rounded-xl bg-weegee-teal p-[12px] mb-8"
              : undefined
          }
        >
          <HeadingTag
            class:list={item.withBackground ? "text-3xl" : "text-xl "}
          >
            <button
              id={titleId}
              type="button"
              class="accordion-trigger flex items-center justify-between w-full text-left font-semibold py-2"
              aria-expanded="false"
              aria-controls={panelId}
            >
              <span>{item.title}</span>

              <svg
                class="accordion-icon fill-none stroke-weegee-black shrink-0 ml-8 transform origin-center transition-transform duration-500 ease-in-out"
                width="48"
                height="48"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path
                  d="m16 10-4 4-4-4"
                  stroke="#000"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </HeadingTag>
          <div
            id={panelId}
            role="region"
            aria-labelledby={titleId}
            class="accordion-panel grid text-sm overflow-hidden transition-all duration-500 ease-in-out grid-rows-[0fr] opacity-0"
          >
            <div class="overflow-hidden">
              {item.items ? (
                <div
                  class="pb-3 pl-4"
                  class:list={
                    item.withBackground
                      ? "bg-weegee-white rounded-md p-2 mt-2"
                      : undefined
                  }
                >
                  <Accordion items={item.items} id={panelId} />
                </div>
              ) : (
                <p class="pb-3 text-lg whitespace-pre-line">{item.content}</p>
              )}
            </div>
          </div>
        </div>
      );
    })
  }
</div>

<script>
  function setExpanded(item: Element, expand: boolean) {
    const trigger = item.querySelector<HTMLButtonElement>(".accordion-trigger");
    const panel = item.querySelector<HTMLElement>(".accordion-panel");
    const icon = trigger?.querySelector<SVGElement>(".accordion-icon");

    trigger?.setAttribute("aria-expanded", String(expand));
    panel?.classList.toggle("grid-rows-[1fr]", expand);
    panel?.classList.toggle("opacity-100", expand);
    panel?.classList.toggle("grid-rows-[0fr]", !expand);
    panel?.classList.toggle("opacity-0", !expand);
    icon?.classList.toggle("!rotate-180", expand);
  }

  document
    .querySelectorAll<HTMLButtonElement>(".accordion-trigger")
    .forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const item = trigger.closest(".accordion-item");
        if (!item) return;
        const expanded = trigger.getAttribute("aria-expanded") === "true";

        if (!expanded) {
          item.parentElement
            ?.querySelectorAll(":scope > .accordion-item")
            .forEach((sibling) => {
              if (sibling !== item) setExpanded(sibling, false);
            });
        }

        setExpanded(item, !expanded);
      });
    });
</script>
