---
// Full-page password prompt for protected pages; closing it returns to the homepage
interface Props {
  error?: boolean;
}

const { error = false } = Astro.props;
---

<dialog
  id="password-modal"
  aria-labelledby="password-modal-title"
  class="m-auto w-[calc(100%-2rem)] max-w-md rounded-xl border-2 border-weegee-teal bg-weegee-white p-0 backdrop:bg-weegee-white"
>
  <div class="relative flex flex-col gap-4 p-8">
    <button
      type="button"
      id="password-modal-close"
      aria-label="Close and return to the homepage"
      class="absolute top-3 right-3 h-9 w-9 rounded-full text-2xl leading-none hover:bg-weegee-teal/10 cursor-pointer"
    >
      &times;
    </button>

    <h2
      id="password-modal-title"
      class="text-3xl text-weegee-teal border-b pb-2 border-weegee-teal/10 pr-8"
    >
      This page is password protected
    </h2>

    <p class="text-base leading-relaxed">
      If you do not have the password please contact{" "}
      <a href="mailto:enquiries@refuweegee.co.uk" class="link">
        enquiries@refuweegee.co.uk
      </a>{" "}
      or call our office on{" "}
      <a href="tel:01414010756" class="link">
        0141 401 0756
      </a>
      .
    </p>

    <form method="POST" class="flex flex-col gap-4">
      <label class="modal-field">
        <span>Password</span>
        <input
          type="password"
          name="password"
          autocomplete="current-password"
          required
          autofocus
          aria-invalid={error ? "true" : undefined}
          aria-describedby={error ? "password-error" : undefined}
        />
      </label>
      {error && (
        <p
          id="password-error"
          class="text-sm font-bold text-weegee-teal-dark"
          role="alert"
        >
          Incorrect password, please try again.
        </p>
      )}
      <button
        type="submit"
        class="w-full bg-weegee-teal text-weegee-white font-bold py-3 px-8 rounded-xl hover:bg-weegee-teal-dark transition-colors cursor-pointer"
      >
        Enter
      </button>
    </form>
  </div>
</dialog>

<style>
  @reference "../styles/global.css";

  .modal-field {
    @apply flex flex-col gap-2 text-sm font-bold;
  }

  .modal-field input {
    @apply w-full rounded-xl border-2 border-weegee-teal/30 bg-weegee-white px-4 py-3 font-normal transition-colors focus:border-weegee-teal focus:outline-none;
  }
</style>

<script>
  // The modal covers the page; closing it in any way leaves for the homepage
  const modal = document.getElementById(
    "password-modal",
  ) as HTMLDialogElement | null;

  if (modal) {
    const leave = () => window.location.assign("/");

    document
      .getElementById("password-modal-close")
      ?.addEventListener("click", leave);

    // Escape key
    modal.addEventListener("cancel", (event) => {
      event.preventDefault();
      leave();
    });

    // Clicking the backdrop
    modal.addEventListener("click", (event) => {
      if (event.target === modal) leave();
    });

    modal.showModal();
  }
</script>
