---
interface Props {
  title: string;
  showBasket?: boolean;
}

const { title, showBasket = false } = Astro.props;
const hasBox = Astro.slots.has("box");
---

<div class="w-full font-black bg-weegee-teal">
  <div
    class="max-w-7xl mx-auto px-6 py-4 md:py-12 grid lg:grid-cols-2 justify-between gap-4 items-center"
  >
    {
      hasBox ? (
        <div class="bg-weegee-white rounded-xl px-6 py-3 max-w-prose flex flex-col gap-2">
          <h1>{title}</h1>
          <div class="font-normal">
            <slot name="box" />
          </div>
        </div>
      ) : (
        <h1>{title}</h1>
      )
    }

    {
      showBasket && (
        <button
          type="button"
          id="banner-basket-button"
          aria-label="View basket and checkout"
          class="relative shrink-0 p-2 rounded-full hover:bg-white/10 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span
            class="block w-9 h-9 bg-weegee-black [mask-image:url(/assets/svgs/merch.svg)] [mask-size:contain] [mask-repeat:no-repeat] [mask-position:center] group-hover:-translate-y-1 transition-transform"
            aria-hidden="true"
          />
          <span
            id="banner-basket-count"
            class="hidden absolute -top-1 -right-1 min-w-5 h-5 px-1 rounded-full bg-weegee-black text-weegee-white text-[11px] font-bold items-center justify-center border-2 border-current"
          >
            0
          </span>
        </button>
      )
    }
  </div>
</div>
