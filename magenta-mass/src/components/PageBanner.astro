---
interface Props {
  title: string;
  background: string;
  showBasket?: boolean;
}

const { title, background, showBasket = false } = Astro.props;
---

<div class=`${background} w-full font-black`>
  <div
    class="max-w-7xl mx-auto px-6 py-4 md:py-12 flex items-center justify-between gap-4"
  >
    <h1>{title}</h1>

    {
      showBasket && (
        <button
          type="button"
          id="banner-basket-button"
          aria-label="View basket and checkout"
          class="relative shrink-0 p-2 rounded-full hover:bg-white/10 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="w-8 h-8"
          >
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
            <path d="M3 6h18" />
            <path d="M16 10a4 4 0 0 1-8 0" />
          </svg>
          <span
            id="banner-basket-count"
            class="hidden absolute -top-1 -right-1 min-w-5 h-5 px-1 rounded-full bg-weegee-black text-weegee-white text-[11px] font-bold leading-5 text-center border-2 border-current"
          >
            0
          </span>
        </button>
      )
    }
  </div>
</div>
