---
import Layout from "../components/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import { products, formatPence } from "../data/products";
---

<Layout title="Shop | Refuweegee">
  <PageBanner slot="banner" title="Refuweegee merch" background="bg-weegee-teal text-weegee-white" showBasket />

  <main class="max-w-7xl mx-auto px-6 py-16">
    <div
      id="canceled-banner"
      class="hidden mb-8 bg-weegee-cream border-2 border-weegee-black rounded-2xl px-6 py-4 items-center justify-between gap-4"
    >
      <p class="text-sm font-bold">Checkout canceled — your basket is still here.</p>
      <button id="dismiss-canceled" class="text-sm underline shrink-0 cursor-pointer">Dismiss</button>
    </div>

    <!-- Balanced 12-column layout mapping uniformly into 3-column rows on desktop -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">

      {products.map((product) => (
        <div class="md:col-span-4 group bg-weegee-white border-2 border-weegee-black rounded-3xl p-4 flex flex-col justify-between hover:shadow-xl transition-all duration-300">

          <div>
            <!-- Image Box with a fixed aspect ratio so all product windows line up perfectly -->
            <div class="bg-weegee-cream rounded-2xl aspect-square mb-4 overflow-hidden border border-weegee-black/5 relative">
              <img
                src={product.image}
                alt={product.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <span class="absolute top-3 left-3 bg-weegee-white px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-widest border border-weegee-black/10">
                {product.category}
              </span>
            </div>

            <!-- Product Details -->
            <div class="px-2">
              <h3 class="text-xl font-bold font-serif mb-1 text-weegee-black">{product.name}</h3>
              <p class="text-weegee-teal font-bold">{formatPence(product.priceInPence)}</p>
            </div>
          </div>

          <!-- CTA Button pinned uniformly to the bottom of every card -->
          <div class="px-2 pt-4">
            <button
              type="button"
              data-add-to-basket
              data-product-id={product.id}
              class="w-full bg-weegee-black text-weegee-white py-3 rounded-xl font-bold text-sm hover:bg-weegee-teal transition-colors cursor-pointer"
            >
              Add to Basket
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Basket -->
    <section id="basket" class="mt-16 bg-weegee-white border-2 border-weegee-black rounded-3xl p-6">
      <h2 class="text-2xl font-bold font-serif mb-4">Your Basket</h2>

      <div id="basket-empty" class="text-sm text-weegee-black/60">Your basket is empty.</div>

      <ul id="basket-items" class="hidden divide-y divide-weegee-black/10"></ul>

      <div id="basket-footer" class="hidden mt-6 pt-6 border-t-2 border-weegee-black items-center justify-between gap-4">
        <p class="text-lg font-bold">
          Total: <span id="basket-total">£0</span>
        </p>
        <button
          id="checkout-button"
          type="button"
          class="bg-weegee-teal text-weegee-black px-6 py-3 rounded-xl font-bold text-sm hover:opacity-90 transition-opacity cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Checkout with Stripe
        </button>
      </div>

      <p id="checkout-error" class="hidden mt-4 text-sm text-red-600 font-bold"></p>
    </section>
  </main>
</Layout>

<template id="basket-item-template">
  <li class="py-4 flex items-center gap-4">
    <img class="w-16 h-16 object-cover rounded-xl border border-weegee-black/10 bg-weegee-cream" />
    <div class="flex-1 min-w-0">
      <p class="font-bold truncate" data-name></p>
      <p class="text-sm text-weegee-black/60" data-unit-price></p>
    </div>
    <div class="flex items-center gap-2">
      <button type="button" data-decrement class="w-8 h-8 rounded-full border-2 border-weegee-black font-bold cursor-pointer hover:bg-weegee-cream">-</button>
      <span class="w-6 text-center font-bold" data-quantity></span>
      <button type="button" data-increment class="w-8 h-8 rounded-full border-2 border-weegee-black font-bold cursor-pointer hover:bg-weegee-cream">+</button>
    </div>
    <p class="w-16 text-right font-bold" data-line-total></p>
    <button type="button" data-remove class="text-weegee-black/40 hover:text-red-600 cursor-pointer" aria-label="Remove item">✕</button>
  </li>
</template>

<script>
  import { getCart, getCartCount, addToCart, updateQuantity, removeFromCart } from "../scripts/cart";
  import { products, formatPence } from "../data/products";

  function renderBasketCount() {
    const countEl = document.getElementById("banner-basket-count");
    if (!countEl) return;
    const count = getCartCount();
    countEl.textContent = String(count);
    countEl.classList.toggle("hidden", count === 0);
  }

  function renderBasket() {
    renderBasketCount();

    const cart = getCart();
    const entries = Object.entries(cart).filter(([, qty]) => qty > 0);

    const emptyEl = document.getElementById("basket-empty")!;
    const listEl = document.getElementById("basket-items") as HTMLUListElement;
    const footerEl = document.getElementById("basket-footer")!;
    const totalEl = document.getElementById("basket-total")!;
    const template = document.getElementById("basket-item-template") as HTMLTemplateElement;

    listEl.innerHTML = "";

    if (entries.length === 0) {
      emptyEl.classList.remove("hidden");
      listEl.classList.add("hidden");
      footerEl.classList.add("hidden");
      footerEl.classList.remove("flex");
      return;
    }

    emptyEl.classList.add("hidden");
    listEl.classList.remove("hidden");
    footerEl.classList.remove("hidden");
    footerEl.classList.add("flex");

    let totalPence = 0;

    for (const [idStr, quantity] of entries) {
      const id = Number(idStr);
      const product = products.find((p) => p.id === id);
      if (!product) continue;

      const lineTotal = product.priceInPence * quantity;
      totalPence += lineTotal;

      const node = template.content.cloneNode(true) as DocumentFragment;
      const li = node.querySelector("li")!;
      li.dataset.productId = String(id);
      (node.querySelector("img") as HTMLImageElement).src = product.image;
      (node.querySelector("img") as HTMLImageElement).alt = product.name;
      node.querySelector("[data-name]")!.textContent = product.name;
      node.querySelector("[data-unit-price]")!.textContent = `${formatPence(product.priceInPence)} each`;
      node.querySelector("[data-quantity]")!.textContent = String(quantity);
      node.querySelector("[data-line-total]")!.textContent = formatPence(lineTotal);

      listEl.appendChild(node);
    }

    totalEl.textContent = formatPence(totalPence);
  }

  document.querySelectorAll<HTMLButtonElement>("[data-add-to-basket]").forEach((button) => {
    button.addEventListener("click", () => {
      const id = Number(button.dataset.productId);
      addToCart(id);
      const original = button.textContent;
      button.textContent = "Added!";
      setTimeout(() => {
        button.textContent = original;
      }, 1000);
    });
  });

  document.getElementById("basket-items")!.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const li = target.closest("li[data-product-id]") as HTMLLIElement | null;
    if (!li) return;

    const id = Number(li.dataset.productId);
    const cart = getCart();
    const currentQty = cart[String(id)] ?? 0;

    if (target.closest("[data-increment]")) {
      updateQuantity(id, currentQty + 1);
    } else if (target.closest("[data-decrement]")) {
      updateQuantity(id, currentQty - 1);
    } else if (target.closest("[data-remove]")) {
      removeFromCart(id);
    }
  });

  async function startCheckout() {
    const button = document.getElementById("checkout-button") as HTMLButtonElement;
    const bannerButton = document.getElementById("banner-basket-button") as HTMLButtonElement | null;
    const errorEl = document.getElementById("checkout-error")!;
    errorEl.classList.add("hidden");

    const cart = getCart();
    const items = Object.entries(cart)
      .filter(([, qty]) => qty > 0)
      .map(([id, quantity]) => ({ id: Number(id), quantity }));

    if (items.length === 0) {
      document.getElementById("basket")!.scrollIntoView({ behavior: "smooth", block: "start" });
      return;
    }

    button.disabled = true;
    button.textContent = "Redirecting…";
    if (bannerButton) bannerButton.disabled = true;

    try {
      const response = await fetch("/api/create-checkout-session", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ items }),
      });

      const data = await response.json();

      if (!response.ok || !data.url) {
        throw new Error(data.error ?? "Something went wrong starting checkout");
      }

      window.location.href = data.url;
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : "Something went wrong starting checkout";
      errorEl.classList.remove("hidden");
      button.disabled = false;
      button.textContent = "Checkout with Stripe";
      if (bannerButton) bannerButton.disabled = false;
    }
  }

  document.getElementById("checkout-button")!.addEventListener("click", startCheckout);
  document.getElementById("banner-basket-button")?.addEventListener("click", startCheckout);

  window.addEventListener("cart:updated", renderBasket);
  renderBasket();

  if (new URLSearchParams(window.location.search).get("canceled") === "1") {
    document.getElementById("canceled-banner")!.classList.remove("hidden");
    document.getElementById("canceled-banner")!.classList.add("flex");
  }
  document.getElementById("dismiss-canceled")!.addEventListener("click", () => {
    document.getElementById("canceled-banner")!.classList.add("hidden");
    document.getElementById("canceled-banner")!.classList.remove("flex");
  });
</script>
