---
import Layout from "../components/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import Card from "../components/Card.astro";
import { fetchUpcomingEvents, type WixEvent } from "../lib/events";

export const prerender = false;

Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=3600, stale-while-revalidate=86400",
);

let events: WixEvent[] = [];
try {
  events = await fetchUpcomingEvents();
} catch (err) {
  console.error("Failed to load events:", err);
}

const formatStart = (start?: string) => {
  if (!start) return null;
  const date = new Date(start);
  if (Number.isNaN(date.getTime())) return null;
  const datePart = date.toLocaleDateString("en-GB", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
  const timePart = date.toLocaleTimeString("en-GB", {
    hour: "2-digit",
    minute: "2-digit",
  });
  return `${datePart} – ${timePart}`;
};

const eventImages: [RegExp, string][] = [
  [/knitting/i, "/assets/events/knitting.webp"],
  [/conversation/i, "/assets/events/conversation.webp"],
  [/pilates/i, "/assets/events/pilates.webp"],
  [/yoga/i, "/assets/events/yoga.webp"],
  [/storytime/i, "/assets/events/storytime.webp"],
  [/art/i, "/assets/events/artclass.webp"],
  [/cinema|documentary|film|filmmaking|movie/i, "/assets/events/film.webp"],
];

const imageFor = (title: string) =>
  eventImages.find(([pattern]) => pattern.test(title))?.[1] ??
  "/assets/events/default.webp";
---

<Layout title="Events">
  <PageBanner slot="banner" title="Events">
    <span slot="box">
      <p>
        We run a range of community events — from wellbeing classes to social
        gatherings. Everyone is welcome.
      </p>
      <p>
        For the latest updates follow us on social media or contact
        <a href="mailto:enquiries@refuweegee.co.uk" class="link"
          >enquiries@refuweegee.co.uk</a
        >
      </p>
    </span>
  </PageBanner>

  <div class="pt-12 flex flex-col gap-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        events.length === 0 && (
          <p class="text-base leading-relaxed">
            No upcoming events right now &ndash; check back soon.
          </p>
        )
      }
      {
        events.map((event) => {
          const when = formatStart(event.start);
          const image = imageFor(event.title);
          return (
            <Card
              title={event.title}
              image={image}
              buttonHref={event.url}
              buttonLabel="Book"
            >
              {when && <p class="font-semibold mb-1">{when}</p>}
              {event.location && <p>{event.location}</p>}
            </Card>
          );
        })
      }
    </div>
  </div>
</Layout>
