---
import Layout from "../components/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import Card from "../components/Card.astro";

export const prerender = false;

interface WixEvent {
  id: string;
  title: string;
  start?: string;
  location?: string;
  url: string;
}

let events: WixEvent[] = [];
try {
  const res = await fetch(new URL("/api/events.json", Astro.url));
  if (res.ok) {
    events = await res.json();
  }
} catch (err) {
  console.error("Failed to load events:", err);
}

const formatStart = (start?: string) => {
  if (!start) return null;
  const date = new Date(start);
  if (Number.isNaN(date.getTime())) return null;
  const datePart = date.toLocaleDateString("en-GB", {
    weekday: "long",
    day: "numeric",
    month: "long",
    year: "numeric",
  });
  const timePart = date.toLocaleTimeString("en-GB", {
    hour: "2-digit",
    minute: "2-digit",
  });
  return `${datePart} – ${timePart}`;
};

const eventImages: [RegExp, string][] = [
  [/knitting/i, "/assets/events/knitting.webp"],
  [/conversation/i, "/assets/events/conversation.webp"],
  [/pilates/i, "/assets/events/pilates.webp"],
  [/yoga/i, "/assets/events/yoga.webp"],
  [/storytime/i, "/assets/events/storytime.webp"],
  [/art/i, "/assets/events/art.webp"],
];

const imageFor = (title: string) =>
  eventImages.find(([pattern]) => pattern.test(title))?.[1];
---

<Layout title="Events">
  <PageBanner slot="banner" title="Events" background="bg-weegee-teal" />

  <div class="pt-12 flex flex-col gap-10">
    <div
      class="bg-weegee-white rounded-3xl border-2 border-weegee-teal p-8 flex flex-col md:flex-row gap-6 items-center overflow-hidden"
    >
      <div class="flex flex-col gap-3 mr-24">
        <h2
          class="text-3xl text-weegee-teal border-b pb-2 border-weegee-teal/10"
        >
          What's on
        </h2>
        <p class="text-base leading-relaxed">
          We run a range of community events — from wellbeing classes to social
          gatherings. Everyone is welcome. For the latest updates follow us on
          social media or get in touch at
          <a
            href="mailto:enquiries@refuweegee.co.uk"
            class="text-weegee-teal underline font-bold"
            >enquiries@refuweegee.co.uk</a
          >.
        </p>
      </div>
      <img
        src="/assets/events/events.webp"
        alt="Community group"
        class="w-full md:w-80 h-44 object-cover rounded-xl shrink-0"
      />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        events.length === 0 && (
          <p class="text-base leading-relaxed">
            No upcoming events right now &ndash; check back soon.
          </p>
        )
      }
      {
        events.map((event) => {
          const when = formatStart(event.start);
          const image = imageFor(event.title);
          return (
            <Card
              title={event.title}
              image={image}
              buttonHref={event.url}
              buttonLabel="Book"
            >
              {when && <p class="font-semibold mb-1">{when}</p>}
              {event.location && <p>{event.location}</p>}
            </Card>
          );
        })
      }
    </div>
  </div>
</Layout>
