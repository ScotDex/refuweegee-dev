---
import Layout from "../components/Layout.astro";
---

<Layout title="Safe with me campaign" pageBackground="bg-weegee-black">
  <!-- Minimalist, high-impact header inside the black layout -->
  <header
    class="max-w-6xl mx-auto px-6 pt-16 pb-8 text-weegee-white border-b border-weegee-white/10"
  >
    <span
      class="text-weegee-teal text-xs uppercase tracking-widest font-bold font-sans"
      >Community Campaign</span
    >
    <h1 class="text-5xl md:text-6xl text-weegee-white mt-2">Safe With Me.</h1>
  </header>

  <main class="max-w-6xl mx-auto px-6 py-12 text-weegee-white">
    <!-- Master Grid Wrapper -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- LEFT CONTAINER: Campaign Pitch & Visual (Spans 7 columns) -->
      <div class="lg:col-span-7 space-y-8">
        <!-- Manifesto Block (Large Text Callout) -->
        <div
          class="bg-weegee-white/5 border-2 border-weegee-white/20 p-8 rounded-xl backdrop-blur-sm"
        >
          <p
            class="text-xl md:text-2xl font-sans font-light leading-relaxed text-weegee-white/90"
          >
            We're asking businesses, public spaces and individuals to identify
            themselves as a <span class="text-weegee-teal font-medium"
              >safe place</span
            > in these times of rising hate.
          </p>
        </div>

        <!-- Secondary Core Content Split into Readable Paragraphs -->
        <div
          class="space-y-4 text-base text-weegee-white leading-relaxed max-w-2xl pl-2"
        >
          <p>
            By completing your details below you identify your business or
            street (if completing as an individual) as being a safe place. You
            will then show up in our list of safe places and in our soon to
            launch map, where we hope to gather thousands of safe spaces across
            Scotland... and beyond!
          </p>
          <p>
            The idea is that if someone is experiencing hate they can easily
            identify you or your business as a safe place to go. Simple
            community awareness and sharing of the good that we see every day.
          </p>
          <p class="font-serif text-2xl text-weegee-teal pt-2 italic">
            Join us. Be <span
              class="font-bold uppercase tracking-wide not-italic text-weegee-white"
              >Safe With Me.</span
            >
          </p>
        </div>

        <!-- The Interactive Campaign Map Embedded Cleanly -->
        <div
          class="border-2 border-weegee-white/20 rounded-xl overflow-hidden shadow-2xl"
        >
          <iframe
            src="https://www.google.com/maps/d/embed?mid=1pMKBfI-hZKBY9CRYXfl5g2wH0ileEhM&ehbc=2E312F&ll=55.8617,-4.2583&z=15"
            class="w-full h-100 block filter invert-[0.9] hue-rotate-180"
            title="Safe Spaces Map"></iframe>
          <!-- Note: The quick CSS filter class above flips a standard google map into a beautiful dark mode that matches your page background perfectly! -->
        </div>

        <!-- Safe Place Registration Form (submissions emailed via FormSubmit) -->
        <div
          id="register"
          class="bg-weegee-white/5 border-2 border-weegee-white/20 p-6 md:p-8 rounded-xl scroll-mt-8"
        >
          <h2 class="text-3xl text-weegee-white mb-2">Register a safe place</h2>
          <p class="text-sm text-weegee-white/70 mb-6">
            Fields marked <span class="text-weegee-teal">*</span> are required.
          </p>

          <div
            id="form-success"
            class="hidden bg-weegee-teal/10 border-2 border-weegee-teal/30 p-6 rounded-xl"
            role="status"
          >
            <h3 class="text-lg font-bold text-weegee-teal mb-2">
              Thank you for being Safe With Me!
            </h3>
            <p class="text-sm text-weegee-white leading-relaxed">
              We've received your details and will be in touch soon.
            </p>
          </div>

          <form
            id="safe-with-me-form"
            action="https://formsubmit.co/enquiries@refuweegee.co.uk"
            method="POST"
            class="grid grid-cols-1 md:grid-cols-2 gap-5"
          >
            <input
              type="hidden"
              name="_subject"
              value="New Safe With Me registration"
            />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_next" id="form-next" value="" />
            <input
              type="text"
              name="_honey"
              class="hidden"
              tabindex="-1"
              autocomplete="off"
            />

            <label class="form-field">
              <span>Your name <span class="text-weegee-teal">*</span></span>
              <input type="text" name="Name" autocomplete="name" required />
            </label>

            <label class="form-field">
              <span>Contact email <span class="text-weegee-teal">*</span></span>
              <input type="email" name="email" autocomplete="email" required />
            </label>

            <label class="form-field">
              <span>Phone</span>
              <input type="tel" name="Phone" autocomplete="tel" />
            </label>

            <label class="form-field">
              <span
                >Who is registering? <span class="text-weegee-teal">*</span></span
              >
              <select name="Who is registering" required>
                <option value="" disabled selected>Please choose</option>
                <option>An individual/residential address</option>
                <option>A business/organisation</option>
                <option>Rather not say</option>
              </select>
            </label>

            <label class="form-field md:col-span-2">
              <span>Address <span class="text-weegee-teal">*</span></span>
              <textarea
                name="Address"
                rows="3"
                autocomplete="street-address"
                required></textarea>
            </label>

            <label class="form-field">
              <span>City <span class="text-weegee-teal">*</span></span>
              <input
                type="text"
                name="City"
                autocomplete="address-level2"
                required
              />
            </label>

            <label class="form-field">
              <span>Postcode <span class="text-weegee-teal">*</span></span>
              <input
                type="text"
                name="Postcode"
                autocomplete="postal-code"
                required
              />
            </label>

            <label class="form-field md:col-span-2">
              <span>Country/Region <span class="text-weegee-teal">*</span></span>
              <input
                type="text"
                name="Country"
                value="United Kingdom"
                autocomplete="country-name"
                required
              />
            </label>

            <label class="form-field">
              <span>Company/Business name</span>
              <input type="text" name="Company" autocomplete="organization" />
            </label>

            <label class="form-field">
              <span>Website or social media</span>
              <input type="text" name="Website or social" />
            </label>

            <label class="form-field md:col-span-2">
              <span
                >Would you like to appear on our map? <span
                  class="text-weegee-teal">*</span
                ></span
              >
              <select name="Appear on map" required>
                <option value="" disabled selected>Please choose</option>
                <option>Yes please</option>
                <option>No thanks</option>
              </select>
            </label>

            <p
              class="md:col-span-2 text-sm text-weegee-white/70 leading-relaxed"
            >
              We need to update the map manually, so if you sign up with your
              home address then we won't add anyone's name, house number or
              street number to the map – only a street name and a wee house
              icon.
            </p>

            <div class="md:col-span-2">
              <button
                type="submit"
                class="w-full md:w-auto bg-weegee-white text-weegee-black font-bold py-3 px-8 rounded-xl hover:bg-weegee-teal hover:text-weegee-white transition-colors cursor-pointer"
              >
                Submit
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- RIGHT CONTAINER: The Campaign Assets & Toolkit (Spans 5 columns) -->
      <!-- Sticks dynamically to the top of the viewport on desktop as you read the left side -->
      <div class="lg:col-span-5 lg:sticky lg:top-8 space-y-6">
        <!-- Poster Download Card (Dark Bento style wrapper) -->
        <div
          class="bg-weegee-black border-2 border-weegee-white/20 p-6 rounded-xl text-center flex flex-col items-center group"
        >
          <div
            class="w-full aspect-square max-w-60 rounded-xl overflow-hidden bg-weegee-black p-2 mb-4 transition-transform duration-300 group-hover:scale-102"
          >
            <img
              src="/assets/safe.webp"
              alt="Safe With Me campaign poster"
              class="w-full h-full object-contain border-2 rounded-2xl border-weegee-white"
              loading="lazy"
            />
          </div>
          <h3 class="text-lg font-bold text-weegee-white mb-2">
            Display the Poster
          </h3>
          <p class="text-weegee-white mb-4 max-w-sm">
            Download and display this poster in your window, or collect a
            physical print from Refuweegee HQ at 24 George Square.
          </p>
          <a
            href="#"
            class="w-full bg-weegee-white text-weegee-black font-bold py-3 px-4 rounded-xl hover:bg-weegee-teal hover:text-weegee-white transition-colors text-sm"
          >
            Download Window Poster
          </a>
        </div>

        <!-- Badges & Contact Info Card -->
        <div
          class="bg-weegee-teal/10 border-2 border-weegee-teal/30 p-6 rounded-xl"
        >
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">📍</span>
            <h3 class="text-lg font-bold text-weegee-teal">
              Pin Badges Available
            </h3>
          </div>
          <p class="text-sm text-weegee-white leading-relaxed mb-4">
            Pin badges are available at Refuweegee HQ, and soon in various local
            shops across the city. All profits directly support refugees in
            Glasgow and Scotland.
          </p>
          <p class="text-weegee-white mb-0">Want to stock them?</p>
          <p>
            Get in touch at
            <a
              href="mailto:enquiries@refuweegee.co.uk"
              class="link-teal"
            >
              enquiries@refuweegee.co.uk
            </a>
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  @reference "../styles/global.css";

  .form-field {
    @apply flex flex-col gap-2 text-sm font-bold text-weegee-white;
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    @apply w-full rounded-xl border-2 border-weegee-white/20 bg-weegee-white/5 px-4 py-3 font-normal text-weegee-white transition-colors focus:border-weegee-teal focus:outline-none;
  }

  .form-field select option {
    @apply bg-weegee-black text-weegee-white;
  }
</style>

<script>
  const form = document.getElementById("safe-with-me-form");
  const next = document.getElementById("form-next") as HTMLInputElement | null;
  const success = document.getElementById("form-success");

  // Send FormSubmit back to this page after submitting
  if (next) {
    next.value = `${window.location.origin}${window.location.pathname}?submitted=1#register`;
  }

  if (new URLSearchParams(window.location.search).has("submitted")) {
    form?.classList.add("hidden");
    success?.classList.remove("hidden");
  }
</script>
