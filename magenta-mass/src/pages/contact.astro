---
import Layout from "../components/Layout.astro";
import PageBanner from "../components/PageBanner.astro";
import MailingListModal from "../components/MailingListModal.astro";
---

<Layout title="Get in touch">
  <PageBanner slot="banner" title="Contact us" />

  <div class="pt-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 auto-rows-auto">
      <!-- FAQs -->
      <div
        class="md:col-span-4 bg-weegee-white rounded-xl p-8 border-2 border-weegee-teal flex flex-col gap-4"
      >
        <h2
          class="text-2xl text-weegee-teal border-b pb-2 border-weegee-teal/10"
        >
          What donations can you accept right now?
        </h2>
        <p class="text-base leading-relaxed">
          We are <strong>OPEN FOR DONATIONS!</strong> You can find all the details
          you need to know about dropping off at our new space at George Square on
          our <a href="/your-donations" class="link-teal">donations page</a>.
          This page also has all the details you need if you're a wonderful
          financial donor too. Thanks as always for choosing to make a difference
          with us!
        </p>
      </div>

      <div
        class="md:col-span-4 bg-weegee-white rounded-xl p-8 border-2 border-weegee-teal flex flex-col gap-4"
      >
        <h2 class="text-2xl text-weegee-teal border-b pb-2 border-weegee-teal/10">
          What volunteering opportunities do you have at the moment?
        </h2>
        <p class="text-base leading-relaxed">
          To discuss volunteering with us, please contact Sharon at
          <a href="mailto:volunteering@refuweegee.co.uk" class="link-teal"
            >volunteering@refuweegee.co.uk</a
          >.
        </p>
      </div>

      <div
        class="md:col-span-4 bg-weegee-white rounded-xl p-8 border-2 border-weegee-teal flex flex-col gap-4"
      >
        <h2
          class="text-2xl text-weegee-teal border-b pb-2 border-weegee-teal/10"
        >
          How do I book an appointment to visit your shop?
        </h2>
        <p class="text-base leading-relaxed">
          You can book an appointment at our shop through a variety of
          organisations in Glasgow and Scotland. Ask your support worker at
          Migrant Help, Scottish Refugee Council, British Red Cross, or any NHS
          Healthcare Worker. Most organisations working with refugee and asylum
          communities in Glasgow have access to our online booking system.
        </p>
        <p class="text-base leading-relaxed">
          Any problems, simply visit us at Refuweegee, 24 George Square on
          Tuesdays or Thursdays between 10am and 4pm and we can help you out!
        </p>
      </div>

      <!-- Contact details -->
      <div
        class="md:col-span-5 bg-weegee-teal text-weegee-white rounded-xl p-8 border-2 border-weegee-teal flex flex-col gap-4"
      >
        <h2 class="text-3xl border-b pb-2 border-weegee-white/20">
          Get in touch
        </h2>
        <p class="text-base leading-relaxed">
          For more information or to discuss your involvement with Refuweegee,
          please contact us or fill in the form with your details.
        </p>
        <dl class="flex flex-col gap-3 text-base">
          <div>
            <dt class="text-sm font-bold uppercase tracking-wide">Email</dt>
            <dd>
              <a
                href="mailto:enquiries@refuweegee.co.uk"
                class="underline font-semibold"
              >
                enquiries@refuweegee.co.uk
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-bold uppercase tracking-wide">Phone</dt>
            <dd>
              <a href="tel:+441414010756" class="underline font-semibold">
                0141 401 0756
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-bold uppercase tracking-wide">Visit us</dt>
            <dd>24 George Square, Glasgow</dd>
          </div>
        </dl>
      </div>

      <!-- Contact form (submissions emailed via FormSubmit) -->
      <div
        id="contact-form"
        class="md:col-span-7 bg-weegee-white rounded-xl p-8 border-2 border-weegee-teal flex flex-col gap-4 scroll-mt-8"
      >
        <h2 class="text-3xl border-b pb-2 border-weegee-black/10">
          Send us a message
        </h2>
        <p class="text-sm text-weegee-black/70">
          Fields marked <span class="text-weegee-teal">*</span> are required.
        </p>

        <div
          id="form-success"
          class="hidden bg-weegee-teal/10 border-2 border-weegee-teal/30 p-6 rounded-xl"
          role="status"
        >
          <p class="font-bold text-weegee-teal">
            Thanks for submitting! We'll be in touch soon.
          </p>
        </div>

        <form
          id="contact-details-form"
          action="https://formsubmit.co/enquiries@refuweegee.co.uk"
          method="POST"
          class="grid grid-cols-1 md:grid-cols-2 gap-5"
        >
          <input type="hidden" name="_subject" value="New contact form enquiry" />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" id="form-next" value="" />
          <input
            type="text"
            name="_honey"
            class="hidden"
            tabindex="-1"
            autocomplete="off"
          />

          <label class="form-field">
            <span>First name <span class="text-weegee-teal">*</span></span>
            <input
              type="text"
              name="First name"
              autocomplete="given-name"
              required
            />
          </label>

          <label class="form-field">
            <span>Last name <span class="text-weegee-teal">*</span></span>
            <input
              type="text"
              name="Last name"
              autocomplete="family-name"
              required
            />
          </label>

          <label class="form-field md:col-span-2">
            <span>Email <span class="text-weegee-teal">*</span></span>
            <input type="email" name="email" autocomplete="email" required />
          </label>

          <label class="form-field md:col-span-2">
            <span>Your message <span class="text-weegee-teal">*</span></span>
            <textarea name="Message" rows="5" required></textarea>
          </label>

          <div class="md:col-span-2">
            <button
              type="submit"
              class="w-full md:w-auto bg-weegee-teal text-weegee-white font-bold py-3 px-8 rounded-xl hover:bg-weegee-teal-dark transition-colors cursor-pointer"
            >
              Submit
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <MailingListModal />
</Layout>

<style>
  @reference "../styles/global.css";

  .form-field {
    @apply flex flex-col gap-2 text-sm font-bold;
  }

  .form-field input,
  .form-field textarea {
    @apply w-full rounded-xl border-2 border-weegee-teal/30 bg-weegee-white px-4 py-3 font-normal transition-colors focus:border-weegee-teal focus:outline-none;
  }
</style>

<script>
  const form = document.getElementById("contact-details-form");
  const next = document.getElementById("form-next") as HTMLInputElement | null;
  const success = document.getElementById("form-success");

  // Send FormSubmit back to this page after submitting
  if (next) {
    next.value = `${window.location.origin}${window.location.pathname}?submitted=1#contact-form`;
  }

  if (new URLSearchParams(window.location.search).has("submitted")) {
    form?.classList.add("hidden");
    success?.classList.remove("hidden");
  }
</script>
